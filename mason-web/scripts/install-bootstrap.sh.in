#!/usr/bin/env bash
# MasonOS — one-line installer bootstrap.
#
#   curl -fsSL https://sexwithmason.com/masonos/install.sh | bash
#
# Downloads the full MasonOS package (plasma style, look-and-feel, decoration,
# wallpaper, Mason Bot widget, masonosctl and the settings app), checks it, then
# hands over to the real installer inside it. Everything lands in ~/.local and
# `masonosctl off` puts your Plasma setup back.
#
# On the Arch Linux ISO the same line installs Arch itself: it hands over to
# masonos/arch-install-gui.sh (the full-screen installer) or, with flags or no
# terminal, to masonos/arch-install.sh (partition a disk, Arch + Plasma 6, then
# MasonOS).
#
# Extra arguments are passed straight through, e.g.
#   curl -fsSL …/install.sh | bash -s -- --no-apply
#   curl -fsSL …/install.sh | bash -s -- --disk /dev/nvme0n1 --yes --password …
set -euo pipefail

BASE_URL="${MASONOS_BASE_URL:-__BASE_URL__}"
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/masonos.XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT

say() { printf ' · %s\n' "$*"; }
die() { printf 'MasonOS: %s\n' "$*" >&2; exit 1; }

fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$2" "$1"
  else
    die "need curl or wget to download MasonOS"
  fi
}

printf '\n  MasonOS installer\n'
say "source: $BASE_URL"

# Running from the Arch ISO? Then there is no desktop to theme yet, and this
# becomes the full install: arch-install.sh, first thing.
ARCH_LIVE=0
if [[ ${EUID:-$(id -u)} -eq 0 ]] && { [[ -d /run/archiso ]] || [[ -f /etc/arch-release ]]; }; then
  ARCH_LIVE=1
  say "Arch live environment: installing Arch Linux + Plasma 6 + MasonOS"
fi

if [[ $ARCH_LIVE -eq 0 ]]; then
  command -v plasmashell >/dev/null 2>&1 || die "this installs a KDE Plasma 6 desktop theme — plasmashell was not found"
  case "${XDG_CURRENT_DESKTOP:-}${XDG_SESSION_TYPE:-}" in
    *KDE*|*Plasma*|*wayland*) : ;;
    *) say "warning: no Plasma session detected in this shell; install will still work" ;;
  esac
fi

fetch "$BASE_URL/masonos.tar.gz" "$TMP_DIR/masonos.tar.gz"
say "downloaded $(du -h "$TMP_DIR/masonos.tar.gz" | cut -f1)"

if command -v sha256sum >/dev/null 2>&1; then
  hash_of() { sha256sum "$1" | cut -d' ' -f1; }
  expected=""
  if fetch "$BASE_URL/sha256.txt" "$TMP_DIR/sha256.txt" 2>/dev/null; then
    expected="$(head -1 "$TMP_DIR/sha256.txt" | cut -d' ' -f1)"
  fi
  if [[ "$expected" != "$(hash_of "$TMP_DIR/masonos.tar.gz")" ]]; then
    # A release that is still uploading, or a CDN holding one file back, looks
    # exactly like this: both files are fine, but from different builds. One
    # fresh fetch past the cache is normally all it takes.
    say "the package and its checksum disagree — fetching both once more"
    fetch "$BASE_URL/masonos.tar.gz?cb=$(date +%s)" "$TMP_DIR/masonos.tar.gz" \
      || die "could not download the package"
    if fetch "$BASE_URL/sha256.txt?cb=$(date +%s)" "$TMP_DIR/sha256.txt" 2>/dev/null; then
      expected="$(head -1 "$TMP_DIR/sha256.txt" | cut -d' ' -f1)"
    fi
  fi
  actual="$(hash_of "$TMP_DIR/masonos.tar.gz")"
  if [[ -n "$expected" && "$expected" != "$actual" ]]; then
    printf 'MasonOS: checksum mismatch — the package on the server is mid-release.\n' >&2
    printf '  expected %s\n  got      %s\n' "${expected:0:16}" "${actual:0:16}" >&2
    printf '  try again in a minute.\n' >&2
    exit 1
  fi
  [[ -n "$expected" ]] && say "checksum ok"
fi

tar -xzf "$TMP_DIR/masonos.tar.gz" -C "$TMP_DIR"
[[ -x "$TMP_DIR/masonos/install.sh" ]] || die "the package is missing install.sh"

if [[ $ARCH_LIVE -eq 1 ]]; then
  [[ -x "$TMP_DIR/masonos/arch-install.sh" ]] || die "the package is missing arch-install.sh"
  say "running the Arch installer — it asks which disk to erase, and erases it"
  printf '\n'
  cd "$TMP_DIR/masonos"
  # stdin was the `curl |` pipe, already at EOF: questions (which disk, the
  # password, the wipe confirmation) need the real terminal instead.
  if ! exec </dev/tty 2>/dev/null; then
    say "no terminal to ask on — pass --disk and --password if it stops"
  fi
  # With a terminal and no flags, show the full-screen installer instead of
  # asking in plain text (dialog menus: disk, account, timezone, options).
  if [[ $# -eq 0 && -x ./arch-install-gui.sh ]]; then
    say "starting the installer window"
    printf '\n'
    exec ./arch-install-gui.sh
  fi
  # The package is the MasonOS checkout, so arch-install.sh copies it from here
  # into ~/mason of the new system. exec keeps the temp dir alive for that.
  exec ./arch-install.sh --repo "$TMP_DIR" "$@"
fi

say "running the installer"
printf '\n'
cd "$TMP_DIR/masonos"
exec ./install.sh "$@"
