def available_kcms() -> set[str]:
    """Ask KDE which modules this machine actually has, so nothing dead is shown."""
    if not shutil.which("kcmshell6"):
        return set()
    try:
        proc = subprocess.run(["kcmshell6", "--list"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return set()
    return {
        line.split()[0]
        for line in (proc.stdout or "").splitlines()
        if line.strip().startswith("kcm_")
    }


def launch_kcm(module: str) -> None:
    if shutil.which("kcmshell6"):
        QProcess.startDetached("kcmshell6", [module])
    elif Path("/usr/bin/systemsettings").exists():
        QProcess.startDetached("/usr/bin/systemsettings", [module])


class SystemPage(Page):
    def __init__(self, app):
        super().__init__(app)
        self.title("System", "MasonOS Settings stands in for KDE System Settings — every "
                            "system panel below is the real KDE one, opened in place.")
        self.available = available_kcms()
        self.buttons: dict[str, QPushButton] = {}

        for group, rows in KCM_GROUPS:
            inner = section(self.body, group)
            grid = QGridLayout()
            grid.setHorizontalSpacing(10)
            grid.setVerticalSpacing(10)
            for index, (label, module, blurb) in enumerate(rows):
                button = QPushButton(label)
                resolved = self._resolve(module)
                installed = resolved is not None
                button.setEnabled(installed)
                button.setToolTip(blurb if installed else f"{blurb} — not installed on this system")
                button.clicked.connect(lambda _=False, mod=resolved or module: launch_kcm(mod.split("|")[0]))
                grid.addWidget(button, index // 2, index % 2)
                self.buttons[module] = button
            inner.addLayout(grid)

        inner = section(self.body, "Full KDE System Settings",
                        "Anything not listed above is still one window away — this opens "
                        "the stock KDE application untouched.")
        row = QHBoxLayout()
        kde_btn = QPushButton("Open KDE System Settings")
        kde_btn.clicked.connect(open_kde_settings)
        row.addWidget(kde_btn)
        row.addStretch(1)
        inner.addLayout(row)
        self.body.addStretch(1)

    def _resolve(self, module: str) -> str | None:
        """First candidate KCM this machine actually ships (power has two names)."""
        for candidate in module.split("|"):
            if not self.available or candidate in self.available:
                return candidate
        return None

    def refresh(self) -> None:
        if not self.available:
            self.available = available_kcms()
        for module, button in self.buttons.items():
            button.setEnabled(self._resolve(module) is not None)


def open_kde_settings() -> None:
    """Bypass our own shim: always the real binary."""
    real = Path("/usr/bin/systemsettings")
    if real.exists():
        QProcess.startDetached(str(real), [])
        return
    found = shutil.which("systemsettings")
    if found:
        QProcess.startDetached(found, [])


