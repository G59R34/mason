#!/usr/bin/env python3
"""MasonOS Settings — the control panel for the MasonOS shell.

A small PySide6 (Qt Widgets) app: it reads state through `masonosctl`, edits the
preferences file `~/.config/masonos/masonos.json`, and never touches Plasma
directly itself. Everything it changes is reversible with `masonosctl off`.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

from PySide6.QtCore import QProcess, Qt, QTimer
from PySide6.QtGui import QFont, QIcon, QPixmap
from PySide6.QtWidgets import (
    QApplication,
    QCheckBox,
    QFrame,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QMessageBox,
    QPushButton,
    QScrollArea,
    QSlider,
    QStackedWidget,
    QVBoxLayout,
    QWidget,
)

HOME = Path.home()
CONFIG_DIR = HOME / ".config" / "masonos"
STATE_DIR = HOME / ".local" / "state" / "masonos"
PREF_FILE = CONFIG_DIR / "masonos.json"
BOT_FILE = CONFIG_DIR / "bot.json"
SHARE = Path(__file__).resolve().parent.parent / "share"
VERSION = "1.0"

PALETTE = {
    "bg": "#08080a",
    "surface": "#12121a",
    "surface_alt": "#17171f",
    "border": "#26262f",
    "text": "#f4f4f5",
    "muted": "#9a9aa8",
    "accent": "#8b5cf6",
    "accent_soft": "#c4b5fd",
    "ok": "#4ade80",
    "warn": "#fbbf24",
}

QSS = f"""
QWidget {{ background: {PALETTE['bg']}; color: {PALETTE['text']};
           font-family: "DM Sans"; font-size: 14px; }}
QLabel {{ background: transparent; }}
#Sidebar {{ background: {PALETTE['surface']}; border-right: 1px solid {PALETTE['border']}; }}
#Wordmark {{ font-family: "Syne"; font-size: 21px; font-weight: 700; letter-spacing: 1px; }}
#Tagline {{ color: {PALETTE['muted']}; font-size: 11px; letter-spacing: 2px; }}
#PageTitle {{ font-family: "Syne"; font-size: 24px; font-weight: 700; }}
#PageHint {{ color: {PALETTE['muted']}; }}
#Card {{ background: {PALETTE['surface']}; border: 1px solid {PALETTE['border']}; border-radius: 14px; }}
#CardTitle {{ font-family: "Syne"; font-size: 15px; font-weight: 700; }}
#Metric {{ color: {PALETTE['muted']}; }}
