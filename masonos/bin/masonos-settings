    def __init__(self, app):
        super().__init__(app)
        self.title("About MasonOS", "A shell and identity for KDE Plasma 6 — any distro, any GPU.")
        inner = section(self.body, f"MasonOS {VERSION}")
        for label, value in (
            ("Shell", "Plasma panels, KWin decoration, Look-and-Feel, Mason Bot"),
            ("Preferences", str(PREF_FILE)),
            ("State & manifest", str(STATE_DIR / "manifest.json")),
            ("Bot log", str(HOME / ".cache" / "masonos" / "bot.log")),
        ):
            row = QHBoxLayout()
            name = QLabel(label)
            name.setObjectName("Metric")
            val = QLabel(value)
            val.setObjectName("Value")
            val.setTextInteractionFlags(Qt.TextSelectableByMouse)
            row.addWidget(name)
            row.addStretch(1)
            row.addWidget(val)
            inner.addLayout(row)
        note = QLabel("Every change here can be undone with `masonosctl off`.")
        note.setObjectName("PageHint")
        inner.addWidget(note)
        self.body.addStretch(1)


# ── window ────────────────────────────────────────────────────────────────────

class MasonSettings(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("MasonOS Settings")
        self.setMinimumSize(880, 600)
        self.resize(980, 660)
        icon = mark_pixmap(64)
        if not icon.isNull():
            self.setWindowIcon(QIcon(icon))

        root = QHBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        sidebar = QWidget()
        sidebar.setObjectName("Sidebar")
        sidebar.setFixedWidth(228)
        side = QVBoxLayout(sidebar)
        side.setContentsMargins(18, 20, 18, 18)
        side.setSpacing(6)

        head = QHBoxLayout()
        logo = QLabel()
        logo.setPixmap(mark_pixmap(28))
        word = QLabel("MasonOS")
        word.setObjectName("Wordmark")
        head.addWidget(logo)
        head.addWidget(word)
        head.addStretch(1)
        side.addLayout(head)
        tag = QLabel("SETTINGS")
        tag.setObjectName("Tagline")
        side.addWidget(tag)
        side.addSpacing(14)

        self.pages = QStackedWidget()
        self.overview = OverviewPage(self)
        self.panels = PanelsPage(self)
        self.bot = BotPage(self)
        self.display = DisplayPage(self)
        self.system = SystemPage(self)
        self.about = AboutPage(self)
        self.page_names = ["overview", "panels", "bot", "display", "system", "about"]
        nav_specs = [("Overview", self.overview), ("Bar && dock", self.panels),
                     ("Mason Bot", self.bot), ("Display", self.display),
                     ("System", self.system), ("About", self.about)]
        self.nav_buttons = []
        for index, (label, page) in enumerate(nav_specs):
            button = QPushButton(label)
            button.setObjectName("Nav")
            button.setCheckable(True)
            button.setChecked(index == 0)
            button.clicked.connect(lambda _=False, i=index: self.show_page(i))
            side.addWidget(button)
            self.nav_buttons.append(button)
            self.pages.addWidget(page)

        side.addStretch(1)
        self.status_badge = QLabel("reading state…")
        self.status_badge.setObjectName("Badge")
        self.status_badge.setWordWrap(True)
        side.addWidget(self.status_badge)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(self.pages)

        root.addWidget(sidebar)
        root.addWidget(scroll, 1)

        self.busy = QLabel("")
        self.busy.setObjectName("PageHint")
        side.addWidget(self.busy)

        self.refresh_all()

    def show_page(self, index: int) -> None:
        self.pages.setCurrentIndex(index)
        for i, button in enumerate(self.nav_buttons):
            button.setChecked(i == index)
        page = self.pages.currentWidget()
        if hasattr(page, "refresh"):
            page.refresh()

    def show_page_named(self, name: str) -> None:
        aliases = {
            "overview": "overview", "bar": "panels", "dock": "panels", "panels": "panels",
            "bot": "bot", "display": "display", "system": "system", "settings": "system",
            "about": "about",
        }
        target = aliases.get(name.strip().lower())
        if target:
            self.show_page(self.page_names.index(target))

    def refresh_all(self) -> None:
        code, out = run_ctl("status")
        status = parse_status(out)
        self.overview.update_state(status)
        active = status.get("active") == "yes"
        self.status_badge.setText(
            f"{'MasonOS active' if active else 'Plasma'}"
            + (f"\n{status.get('display', '')}" if status.get("display") else "")
        )
        self.display.refresh()
        self.bot.reload()

    def ctl(self, label: str, *args: str, reload_after: bool = True) -> None:
        if self.busy.text():
            return
        self.busy.setText(label)
        self.setEnabled(False)
        self._process = QProcess(self)
        self._process.finished.connect(lambda code, _status: self._ctl_done(code, reload_after))
        self._process.start(ctl_path(), list(args))

    def _ctl_done(self, code: int, reload_after: bool) -> None:
        self.setEnabled(True)
        if code == 0:
            self.busy.setText("")
        else:
            self.busy.setText("That step failed — see the journal for details.")
        if reload_after:
            QTimer.singleShot(400, self.refresh_all)


# A KCM that has a MasonOS page of its own opens that page instead of a second window.
KCM_TO_PAGE = {"kcm_kscreen": "display"}


def main(argv: list[str]) -> int:
    page = None
    rest: list[str] = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--page" and index + 1 < len(argv):
            page = argv[index + 1]
            index += 2
            continue
        rest.append(arg)
        index += 1

    # `systemsettings kcm_x` requests are forwarded here by our shim. Panels we
    # have a page for open in-app; everything else is KDE's own window.
    requested = [arg for arg in rest if arg.startswith("kcm_") or arg.startswith("kcm-")]
    if requested:
        module = requested[0].split()[0]
        if module in KCM_TO_PAGE:
            page = KCM_TO_PAGE[module]
        else:
            launch_kcm(module)
            return 0

    app = QApplication([rest[0] if rest else "masonos-settings"])
    app.setApplicationName("MasonOS Settings")
    app.setStyleSheet(QSS)
    window = MasonSettings()
    if page:
        window.show_page_named(page)
    if "--screenshot" in rest:
        target = rest[rest.index("--screenshot") + 1]
        window.show()
        app.processEvents()
        window.grab().save(target)
        print(f"wrote {target}")
        return 0
    window.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
