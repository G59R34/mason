#!/usr/bin/env python3
"""MasonOS Settings — the control panel for the MasonOS shell.

A small PySide6 (Qt Widgets) app: it reads state through `masonosctl`, edits the
preferences file `~/.config/masonos/masonos.json`, and never touches Plasma
directly itself. Everything it changes is reversible with `masonosctl off`.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

from PySide6.QtCore import QProcess, Qt, QTimer
from PySide6.QtGui import QFont, QIcon, QPixmap
from PySide6.QtWidgets import (
    QApplication,
    QCheckBox,
    QFrame,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QMessageBox,
    QPushButton,
    QScrollArea,
    QSlider,
    QStackedWidget,
    QVBoxLayout,
    QWidget,
)

HOME = Path.home()
CONFIG_DIR = HOME / ".config" / "masonos"
STATE_DIR = HOME / ".local" / "state" / "masonos"
PREF_FILE = CONFIG_DIR / "masonos.json"
BOT_FILE = CONFIG_DIR / "bot.json"
SHARE = Path(__file__).resolve().parent.parent / "share"
VERSION = "1.0"

