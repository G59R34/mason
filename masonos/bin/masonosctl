#!/usr/bin/env python3
"""masonosctl — transform KDE Plasma into MasonOS, and undo it again.

MasonOS is a shell layer plus a visual identity on top of Plasma 6: our panel
layout, palette, desktop style, Look-and-Feel (splash), window decoration, icon
overrides, GTK accent and the Mason Bot widget.

    masonosctl on         transform into MasonOS        (alias: transform)
    masonosctl off        restore the Plasma you had    (alias: revert)
    masonosctl reload     off + on, after editing assets (what the desktop icon runs)
    masonosctl toggle
    masonosctl status     what is applied, and what would be restored
    masonosctl check-update   is the published MasonOS newer than this one?
    masonosctl update     download and run the published installer
    masonosctl transform --dry-run

Every setting it changes is recorded in
~/.local/state/masonos/manifest.json before it is touched, so `off` puts your
previous scheme, decoration, icons, fonts, GTK css and appletsrc back exactly.
"""

from __future__ import annotations

import argparse
import gzip
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.request
from pathlib import Path
from urllib.parse import unquote, urlparse

HOME = Path.home()
ROOT = Path(__file__).resolve().parent.parent
SHARE = ROOT / "share"
BOT_SCRIPT = ROOT / "bot" / "masonos-bot.py"

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
DATA_DIR = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local" / "share")
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "masonos"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "masonos"

APPLETSRC = CONFIG_DIR / "plasma-org.kde.plasma.desktop-appletsrc"
MANIFEST_FILE = STATE_DIR / "manifest.json"
APPLETSRC_BACKUP = STATE_DIR / "appletsrc.pre-masonos"
BOT_PID_FILE = STATE_DIR / "bot.pid"
BOT_LOG = CACHE_DIR / "bot.log"

WALLPAPER = DATA_DIR / "wallpapers" / "masonos.png"
BOT_HEALTH_URL = "http://127.0.0.1:8765/health"

# Where the published installer lives, and what this install thinks it is. The
# version is a MASONOS_VERSION="x.y.z" line inside install.sh on both ends.
UPDATE_URL = "https://sexwithmason.com/masonos/install.sh"
VERSION_FILE = STATE_DIR / "version"
UPDATE_CHECK_FILE = CACHE_DIR / "update-check.json"
UPDATE_CHECK_TTL = 6 * 3600

APP_ID = "com.mason.masonos.bot"
SCHEME = "MasonOS"
DESKTOP_THEME = "com.mason.masonos"
LOOK_AND_FEEL = "com.mason.masonos"
ICON_THEME = "MasonOS"
DECORATION = "__aurorae__svg__MasonOS"
DECORATION_LIBRARY = "org.kde.kwin.aurorae.v2"
KWIN_SCRIPT = "masonos-shell"
CURSOR_THEME = "breeze_cursors"
BODY_FONT = "DM Sans"

# Every INI key the transformation touches, snapshotted before the first write.
TRACKED = [
    ("kdeglobals", "General", "ColorScheme"),
    ("kdeglobals", "General", "font"),
    ("kdeglobals", "General", "menuFont"),
    ("kdeglobals", "General", "toolBarFont"),
    ("kdeglobals", "Icons", "Theme"),
    ("kdeglobals", "KDE", "LookAndFeelPackage"),
    ("kdeglobals", "KDE", "widgetStyle"),
    ("plasmarc", "Theme", "name"),
    ("kwinrc", "org.kde.kdecoration2", "library"),
    ("kwinrc", "org.kde.kdecoration2", "theme"),
    ("kwinrc", "Plugins", f"{KWIN_SCRIPT}Enabled"),
    ("ksplashrc", "KSplash", "Theme"),
    ("kcminputrc", "Mouse", "cursorTheme"),
    ("kscreenlockerrc", "Greeter", "WallpaperPlugin"),
]

GTK_FILES = [
    CONFIG_DIR / "gtk-3.0" / "gtk.css",
    CONFIG_DIR / "gtk-4.0" / "gtk.css",
]
GTK_INCLUDE = '@import url("masonos.css");'

# User-tweakable geometry, written by MasonOS Settings and read on every transform.
SETTINGS_FILE = CONFIG_DIR / "masonos" / "masonos.json"
PREF_DEFAULTS = {"barHeight": 45, "dockHeight": 48}


def load_prefs() -> dict:
    prefs = dict(PREF_DEFAULTS)
    try:
        data = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return prefs
    for key, default in PREF_DEFAULTS.items():
        value = data.get(key)
        if isinstance(value, (int, float)):
            prefs[key] = max(32, min(96, int(value)))
    return prefs


def save_prefs(prefs: dict) -> None:
    SETTINGS_FILE.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS_FILE.write_text(json.dumps(prefs, indent=2) + "\n", encoding="utf-8")

PANEL_TEMPLATE = r"""
var made = [];

function addPanel(location, height, alignment, lengthMode, floating, widgets) {
    var panel = null;
    try {
        panel = new Panel("org.kde.panel");
    } catch (e) {
        panel = new Panel();
    }
    panel.location = location;
    panel.height = height;
    panel.alignment = alignment;
    panel.lengthMode = lengthMode;
    try { panel.floating = floating; } catch (e) {}
    for (var i = 0; i < widgets.length; i++) {
        var applet = null;
        try { applet = panel.addWidget(widgets[i]); } catch (e) {
            print("masonos_widget_failed=" + widgets[i]);
        }
        if (widgets[i] === "org.kde.plasma.kickerdash" && applet) {
            try {
                applet.currentConfigGroup = ["Configuration", "General"];
                applet.writeConfig("icon", "masonos");
                applet.reloadConfig();
            } catch (e) {}
        }
    }
    return panel.id;
}

var current = panels();
for (var i = 0; i < current.length; i++) {
    try { current[i].remove(); } catch (e) {}
}

/* Panel heights are logical pixels in the scripting API. */
made.push(addPanel("top", __BAR_HEIGHT__, "left", "custom", false, __TOP_WIDGETS__));

/* Centred floating dock, sized from MasonOS Settings (prefs.dockHeight). */
made.push(addPanel("bottom", __DOCK_HEIGHT__, "center", "fit", true, ["org.kde.plasma.icontasks"]));

print("masonos_panels=" + made.join(","));
"""

TOP_WIDGETS_CENTRED = [
    "org.kde.plasma.kickerdash",
    "org.kde.plasma.panelspacer",
    "org.kde.plasma.digitalclock",
    "org.kde.plasma.panelspacer",
    "com.mason.masonos.bot",
    "org.kde.plasma.systemtray",
    "org.kde.plasma.minimizeall",
]

# A notched MacBook physically blocks the middle of the top edge, so the clock
# joins the right-hand cluster and the centre stays empty.
TOP_WIDGETS_NOTCHED = [
    "org.kde.plasma.kickerdash",
    "org.kde.plasma.panelspacer",
    "com.mason.masonos.bot",
    "org.kde.plasma.systemtray",
    "org.kde.plasma.minimizeall",
    "org.kde.plasma.digitalclock",
]


def panel_script(bar_height: int, notched: bool, dock_height: int) -> str:
    widgets = TOP_WIDGETS_NOTCHED if notched else TOP_WIDGETS_CENTRED
    return (
        PANEL_TEMPLATE.replace("__BAR_HEIGHT__", str(bar_height))
        .replace("__DOCK_HEIGHT__", str(dock_height))
        .replace("__TOP_WIDGETS__", json.dumps(widgets))
    )

# Plasma's own stock two-panel layout, rebuilt when no usable snapshot exists.
STOCK_PANEL_SCRIPT = r"""
var made = [];

function addPanel(alignment, widgets) {
    var panel = null;
    try {
        panel = new Panel("org.kde.panel");
    } catch (e) {
        panel = new Panel();
    }
    panel.location = "top";
    panel.height = 44;
    panel.alignment = alignment;
    panel.lengthMode = "custom";
    try { panel.floating = false; } catch (e) {}
    for (var i = 0; i < widgets.length; i++) {
        try { panel.addWidget(widgets[i]); } catch (e) {}
    }
    return panel.id;
}

var current = panels();
for (var i = 0; i < current.length; i++) {
    try { current[i].remove(); } catch (e) {}
}

made.push(addPanel("left", [
    "org.kde.plasma.kickoff",
    "org.kde.plasma.pager",
    "org.kde.plasma.icontasks",
    "org.kde.plasma.panelspacer"
]));
made.push(addPanel("right", [
    "org.kde.plasma.panelspacer",
    "org.kde.plasma.systemtray",
    "org.kde.plasma.digitalclock",
    "org.kde.plasma.showdesktop"
]));

print("masonos_stock_panels=" + made.join(","));
"""


# ── shell helpers ────────────────────────────────────────────────────────────


def run(cmd: list[str], timeout: float = 45) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(cmd, text=True, capture_output=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as err:
        return subprocess.CompletedProcess(cmd, 127, "", str(err))


def have(binary: str) -> bool:
    return shutil.which(binary) is not None


def pyside_python() -> str:
    """The Python that has PySide6: the one install.sh recorded, else this one."""
    shim = DATA_DIR / "masonos" / "pyside-python"
    if shim.is_file() and os.access(shim, os.X_OK):
        return str(shim)
    return sys.executable


def have_pyside(module: str = "PySide6") -> bool:
    return run([pyside_python(), "-c", f"import {module}"]).returncode == 0


def session_type() -> str:
    """wayland, x11, or "" when this shell is not inside a graphical session."""
    kind = (os.environ.get("XDG_SESSION_TYPE") or "").lower()
    if kind in ("wayland", "x11"):
        return kind
    if os.environ.get("WAYLAND_DISPLAY"):
        return "wayland"
    if os.environ.get("DISPLAY"):
        return "x11"
    return ""


def plasma_version() -> tuple[int, int, int] | None:
    """MasonOS targets Plasma 6; report what this session actually runs."""
    if not have("plasmashell"):
        return None
    text = f"{run(['plasmashell', '--version']).stdout or ''} {run(['plasmashell', '-v']).stdout or ''}"
    match = re.search(r"(\d+)\.(\d+)(?:\.(\d+))?", text)
    if not match:
        return None
    return (int(match.group(1)), int(match.group(2)), int(match.group(3) or 0))


def plasma_version_text() -> str:
    version = plasma_version()
    return ".".join(str(part) for part in version) if version else "unknown"


def notify(title: str, body: str) -> None:
    if body and have("notify-send"):
        run(["notify-send", "--app-name=MasonOS", "--icon=masonos", title, body], timeout=10)


def kread(file: str, group: str, key: str) -> str | None:
    if not have("kreadconfig6"):
        return None
    out = (run(["kreadconfig6", "--file", file, "--group", group, "--key", key]).stdout or "").strip()
    return out or None


def kwrite(file: str, group: str, key: str, value: str | None) -> None:
    if value is None:
        run(["kwriteconfig6", "--file", file, "--group", group, "--key", key, "--delete"])
    else:
        run(["kwriteconfig6", "--file", file, "--group", group, "--key", key, value])


def font_family(name: str) -> str:
    if have("fc-match"):
        out = (run(["fc-match", "-f", "%{family}", name]).stdout or "").strip()
        if name.lower() in out.lower():
            return name
    return "Noto Sans"


def _decode_busctl(out: str) -> str:
    out = out.strip()
    if out.startswith('s "'):
        out = out[3:]
        if out.endswith('"'):
            out = out[:-1]
        out = out.replace("\\n", "\n").replace('\\"', '"').replace("\\\\", "\\")
    return out


def _decode_gdbus(out: str) -> str:
    out = out.strip()
    if out.startswith("(") and out.endswith(")"):
        out = out[1:-1].strip().rstrip(",").strip()
    if len(out) >= 2 and out[0] == out[-1] and out[0] in "'\"":
        quote = out[0]
        out = out[1:-1]
        out = (out.replace("\\n", "\n").replace("\\t", "\t")
                  .replace(f"\\{quote}", quote).replace("\\\\", "\\"))
    return out


def plasma_script(js: str) -> str:
    """Run JS inside plasmashell.

    busctl (systemd) is tried first, then gdbus (glib2) — Plasma runs on distros
    without systemd, and either tool can reach the same session bus.
    """
    attempts: list[tuple[list[str], object]] = []
    if have("busctl"):
        attempts.append(([
            "busctl", "--user", "call", "org.kde.plasmashell", "/PlasmaShell",
            "org.kde.PlasmaShell", "evaluateScript", "s", js,
        ], _decode_busctl))
    if have("gdbus"):
        attempts.append(([
            "gdbus", "call", "--session", "--dest", "org.kde.plasmashell",
            "--object-path", "/PlasmaShell",
            "--method", "org.kde.PlasmaShell.evaluateScript", js,
        ], _decode_gdbus))
    if not attempts:
        raise RuntimeError(
            "neither busctl (systemd) nor gdbus (glib2) is installed, so plasmashell cannot be scripted"
        )

    errors: list[str] = []
    for cmd, decode in attempts:
        result = run(cmd)
        out = (result.stdout or "").strip()
        if result.returncode == 0 and not out.startswith("Call failed"):
            return decode(out)  # type: ignore[operator]
        errors.append(out or (result.stderr or "").strip())
    raise RuntimeError(errors[-1] or "plasmashell is not answering")


def shell_ready() -> bool:
    for _ in range(90):
        try:
            plasma_script("print(1);")
            return True
        except RuntimeError:
            time.sleep(0.2)
    return False


def restart_plasmashell() -> bool:
    if have("systemctl"):
        if run(["systemctl", "--user", "restart", "plasma-plasmashell.service"]).returncode == 0:
            return shell_ready()
    if have("kquitapp6"):
        run(["kquitapp6", "plasmashell"])
        time.sleep(1.0)
    try:
        subprocess.Popen(
            ["plasmashell"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True
        )
    except OSError:
        return False
    return shell_ready()


def reconfigure_kwin() -> None:
    if have("busctl"):
        run(["busctl", "--user", "call", "org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure"])
    elif have("gdbus"):
        run([
            "gdbus", "call", "--session", "--dest", "org.kde.KWin", "--object-path", "/KWin",
            "--method", "org.kde.KWin.reconfigure",
        ])


# ── display: scaling and the MacBook notch ───────────────────────────────────

TARGET_PPI = 130.0
NOTCH_HEIGHT_PROP = "apple,notch-height"
SHOW_NOTCH_PARAM = Path("/sys/module/appledrm/parameters/show_notch")
DEFAULT_BAR_HEIGHT = 40


def kscreen_info() -> dict | None:
    """Primary output geometry, straight from KScreen."""
    if not have("kscreen-doctor"):
        return None
    result = run(["kscreen-doctor", "-j"])
    if result.returncode != 0 or not (result.stdout or "").strip():
        return None
    try:
        data = json.loads(result.stdout)
    except ValueError:
        return None
    outputs = [o for o in data.get("outputs", []) if o.get("enabled") and o.get("connected")]
    if not outputs:
        return None
    out = sorted(outputs, key=lambda o: o.get("priority", 99))[0]
    size = out.get("size") or {}
    mm = out.get("sizeMM") or {}
    width = int(size.get("width") or 0)
    height = int(size.get("height") or 0)
    scale = float(out.get("scale") or 1.0)
    ppi = (width / (mm["width"] / 25.4)) if mm.get("width") else 0.0
    return {
        "name": out.get("name", "eDP-1"),
        "width": width,
        "height": height,
        "scale": scale,
        "ppi": ppi,
        "logicalWidth": width / scale if scale else width,
    }


def notch_info(scale: float) -> dict | None:
    """Asahi exposes the notch height on the DCP devicetree node."""
    for node in sorted(Path("/sys/firmware/devicetree/base/soc").glob("dcp*")):
        try:
            raw = (node / NOTCH_HEIGHT_PROP).read_bytes()[:4]
        except OSError:
            continue
        if len(raw) < 4:
            continue
        height_px = int.from_bytes(raw, "big")
        if height_px <= 0:
            continue
        visible = True
        try:
            visible = SHOW_NOTCH_PARAM.read_text().strip().upper() not in ("N", "0")
        except OSError:
            pass
        return {
            "heightPx": height_px,
            "heightLogical": height_px / scale if scale else float(height_px),
            "visible": visible,
        }
    return None


def recommended_scale(ppi: float) -> float:
    """Aim for ~130 effective PPI — the density macOS defaults to on these panels."""
    if ppi <= 0:
        return 1.0
    snapped = math.floor((ppi / TARGET_PPI) * 4 + 0.5) / 4
    return max(1.0, min(3.0, snapped))


def format_scale(value: float) -> str:
    return f"{value:.2f}".rstrip("0").rstrip(".") or "1"


def prepare_display(manifest: dict, quiet: bool = False, dry_run: bool = False) -> dict:
    """Fix the scale if the panel is too dense, then size the bar around the notch."""
    info = kscreen_info() or {}
    current = float(info.get("scale") or 1.0)
    target = recommended_scale(float(info.get("ppi") or 0))
    wayland = session_type() != "x11"

    if info and not wayland and current < target - 0.05 and not quiet:
        print(
            "masonosctl: X11 session — leaving the display scale alone "
            "(fractional scaling needs Wayland)."
        )

    # Only ever grow the UI: a density the user picked deliberately is left alone.
    if info and wayland and current < target - 0.05:
        if not dry_run:
            if not manifest.get("display"):
                manifest["display"] = {"output": info["name"], "scale": current}
            run(["kscreen-doctor", f"output.{info['name']}.scale.{format_scale(target)}"])
            time.sleep(1.5)
            info = kscreen_info() or info
        if not quiet or dry_run:
            print(
                f"masonosctl: display scale {format_scale(current)} -> {format_scale(target)} "
                f"({float(info.get('ppi') or 0):.0f} ppi on {info.get('name', 'output')})"
            )

    scale = float(info.get("scale") or current or 1.0)
    notch = notch_info(scale)
    notched = bool(notch and notch["visible"])
    bar_height = int(load_prefs()["barHeight"])
    if notched:
        bar_height = max(bar_height, int(math.ceil(notch["heightLogical"])) + 8)

    return {"info": info, "notch": notch, "barHeight": bar_height, "notched": notched}


# ── manifest ─────────────────────────────────────────────────────────────────


def read_manifest() -> dict:
    try:
        data = json.loads(MANIFEST_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_manifest(manifest: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    MANIFEST_FILE.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def snapshot(manifest: dict) -> None:
    """Record the pre-MasonOS value of everything we are about to change."""
    manifest.setdefault("settings", {})
    for file, group, key in TRACKED:
        manifest["settings"].setdefault(file, {}).setdefault(group, {}).setdefault(key, kread(file, group, key))
    manifest.setdefault("gtk", {})
    for path in GTK_FILES:
        entry = manifest["gtk"].setdefault(str(path), {})
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            text = None
        entry.setdefault("existed", text is not None)
        entry.setdefault("hadInclude", bool(text and GTK_INCLUDE in text))
    write_manifest(manifest)


def restore_settings(manifest: dict) -> None:
    for file, groups in (manifest.get("settings") or {}).items():
        for group, keys in groups.items():
            for key, value in keys.items():
                kwrite(file, group, key, value)


# ── bot bridge ───────────────────────────────────────────────────────────────


def bot_health() -> dict | None:
    try:
        with urllib.request.urlopen(BOT_HEALTH_URL, timeout=1.5) as response:
            payload = json.loads(response.read().decode("utf-8", "replace"))
            return payload if isinstance(payload, dict) else None
    except Exception:
        return None


def pid_is_bot(pid: int) -> bool:
    try:
        return "masonos-bot.py" in Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", "replace")
    except OSError:
        return False


def start_bot() -> bool:
    if bot_health():
        return True
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    log = open(BOT_LOG, "ab", buffering=0)
    try:
        proc = subprocess.Popen(
            [sys.executable, str(BOT_SCRIPT)], stdout=log, stderr=log, start_new_session=True
        )
    except OSError:
        return False
    BOT_PID_FILE.write_text(str(proc.pid), encoding="utf-8")
    for _ in range(50):
        time.sleep(0.1)
        if bot_health():
            return True
        if proc.poll() is not None:
            return False
    return False


def stop_bot() -> None:
    try:
        pid = int(BOT_PID_FILE.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        pid = 0
    if pid and pid_is_bot(pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    BOT_PID_FILE.unlink(missing_ok=True)


# ── assets ───────────────────────────────────────────────────────────────────


def install_plasmoid(package: Path) -> bool:
    if not package.exists() or not have("kpackagetool6"):
        return False
    if run(["kpackagetool6", "--type", "Plasma/Applet", "--upgrade", str(package)]).returncode == 0:
        return True
    return run(["kpackagetool6", "--type", "Plasma/Applet", "--install", str(package)]).returncode == 0


def install_kwin_script(package: Path) -> bool:
    if not package.exists() or not have("kpackagetool6"):
        return False
    if run(["kpackagetool6", "--type", "KWin/Script", "--upgrade", str(package)]).returncode == 0:
        return True
    return run(["kpackagetool6", "--type", "KWin/Script", "--install", str(package)]).returncode == 0


def copy_tree(src: Path, dest: Path, *, gzip_svg: bool = False) -> None:
    if not src.exists():
        return
    if dest.exists():
        shutil.rmtree(dest)
    shutil.copytree(src, dest)
    if gzip_svg:
        # Plasma 6 ships desktop-theme frames as .svgz; match it exactly.
        for svg in list(dest.rglob("*.svg")):
            with open(svg, "rb") as src_file, gzip.open(svg.with_suffix(".svgz"), "wb") as out:
                shutil.copyfileobj(src_file, out)
            svg.unlink()


def install_assets() -> list[str]:
    done: list[str] = []
    DATA_DIR.mkdir(parents=True, exist_ok=True)

    if install_plasmoid(SHARE / "plasmoids" / APP_ID):
        done.append("bot widget")
    if install_kwin_script(SHARE / "kwin" / KWIN_SCRIPT):
        done.append("kwin script")

    scheme = SHARE / "color-schemes" / f"{SCHEME}.colors"
    if scheme.exists():
        target = DATA_DIR / "color-schemes" / f"{SCHEME}.colors"
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(scheme, target)
        done.append("palette")

    copy_tree(SHARE / "desktoptheme" / DESKTOP_THEME, DATA_DIR / "plasma" / "desktoptheme" / DESKTOP_THEME, gzip_svg=True)
    done.append("plasma style")
    copy_tree(SHARE / "look-and-feel" / LOOK_AND_FEEL, DATA_DIR / "plasma" / "look-and-feel" / LOOK_AND_FEEL)
    done.append("look and feel")
    copy_tree(SHARE / "aurorae" / "themes" / "MasonOS", DATA_DIR / "aurorae" / "themes" / "MasonOS")
    done.append("window decoration")
    copy_tree(SHARE / "icons" / ICON_THEME, DATA_DIR / "icons" / ICON_THEME)
    done.append("icon overrides")

    for name, src, dest in [
        ("wallpaper", SHARE / "wallpapers" / "masonos.png", WALLPAPER),
        ("icon", SHARE / "icons" / "masonos.svg", DATA_DIR / "icons" / "hicolor" / "scalable" / "apps" / "masonos.svg"),
        ("gtk css", SHARE / "gtk" / "masonos.css", CONFIG_DIR / "gtk-3.0" / "masonos.css"),
    ]:
        if src.exists():
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dest)
            done.append(name)
    gtk4 = CONFIG_DIR / "gtk-4.0" / "masonos.css"
    if (SHARE / "gtk" / "masonos.css").exists():
        gtk4.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(SHARE / "gtk" / "masonos.css", gtk4)
    return done


# ── applying the identity ────────────────────────────────────────────────────


def apply_look_and_feel() -> None:
    # --apply is required; a bare package name just prints the usage text.
    if have("plasma-apply-lookandfeel"):
        run(["plasma-apply-lookandfeel", "--apply", LOOK_AND_FEEL])


def apply_scheme_and_wallpaper() -> None:
    if have("plasma-apply-colorscheme"):
        run(["plasma-apply-colorscheme", SCHEME])
    if WALLPAPER.exists() and have("plasma-apply-wallpaperimage"):
        run(["plasma-apply-wallpaperimage", str(WALLPAPER)])


def apply_fonts() -> None:
    family = font_family(BODY_FONT)
    for key in ("font", "menuFont", "toolBarFont"):
        kwrite("kdeglobals", "General", key, f"{family},10")


def apply_desktop_theme() -> None:
    if have("plasma-apply-desktoptheme"):
        run(["plasma-apply-desktoptheme", DESKTOP_THEME])
    else:
        kwrite("plasmarc", "Theme", "name", DESKTOP_THEME)


def apply_icons() -> None:
    kwrite("kdeglobals", "Icons", "Theme", ICON_THEME)


def apply_cursor() -> None:
    if have("plasma-apply-cursortheme"):
        run(["plasma-apply-cursortheme", CURSOR_THEME])
    else:
        kwrite("kcminputrc", "Mouse", "cursorTheme", CURSOR_THEME)


def apply_decoration() -> None:
    kwrite("kwinrc", "org.kde.kdecoration2", "library", DECORATION_LIBRARY)
    kwrite("kwinrc", "org.kde.kdecoration2", "theme", DECORATION)
    reconfigure_kwin()


def apply_kwin_script() -> None:
    kwrite("kwinrc", "Plugins", f"{KWIN_SCRIPT}Enabled", "true")
    reconfigure_kwin()


def apply_gtk() -> None:
    include = GTK_INCLUDE
    for path in GTK_FILES:
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            text = ""
        if include not in text:
            path.write_text(text.rstrip() + ("\n\n" if text.strip() else "") + include + "\n", encoding="utf-8")


def remove_gtk_include() -> None:
    for path in GTK_FILES:
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        lines = [line for line in text.splitlines() if GTK_INCLUDE not in line]
        path.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def build_panels(bar_height: int = DEFAULT_BAR_HEIGHT, notched: bool = False,
                 dock_height: int | None = None) -> list[int]:
    if dock_height is None:
        dock_height = load_prefs()["dockHeight"]
    output = plasma_script(panel_script(bar_height, notched, dock_height))
    for line in output.splitlines():
        if line.startswith("masonos_panels="):
            return [int(part) for part in line.split("=", 1)[1].split(",") if part.strip().isdigit()]
    raise RuntimeError(f"plasmashell did not confirm the panel layout: {output or 'no output'}")


def appletsrc_has_masonos(path: Path) -> bool:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    return APP_ID in text or "org.kde.plasma.kickerdash" in text


def restore_stock_panels() -> bool:
    try:
        plasma_script(STOCK_PANEL_SCRIPT)
        return True
    except RuntimeError as err:
        print(f"masonosctl: could not rebuild the stock panels: {err}", file=sys.stderr)
        return False


SETTINGS_ENTRY = DATA_DIR / "applications" / "systemsettings.desktop"
SETTINGS_SHIM = HOME / ".local" / "bin" / "systemsettings"

SOFTWARE_ENTRY = DATA_DIR / "applications" / "masons-software.desktop"
DISCOVER_SHADOW = DATA_DIR / "applications" / "org.kde.discover.desktop"
DISCOVER_SHIM = HOME / ".local" / "bin" / "plasma-discover"


def apply_settings_replacement() -> list[str]:
    """Make MasonOS Settings stand in for KDE System Settings.

    Two pieces: a desktop entry shadowing the stock ``systemsettings.desktop`` in
    the app grid, and a shim earlier on PATH than /usr/bin/systemsettings so the
    tray's Configure items land in the same place. Both are removed by ``off``.
    """
    done: list[str] = []
    template = SHARE / "systemsettings.desktop.in"
    settings_app = HOME / ".local" / "bin" / "masonos-settings"
    if template.exists() and (have("masonos-settings") or settings_app.exists()):
        text = template.read_text(encoding="utf-8").replace(
            "@MASONOSCTL@", str(HOME / ".local" / "bin" / "masonosctl")
        )
        SETTINGS_ENTRY.parent.mkdir(parents=True, exist_ok=True)
        SETTINGS_ENTRY.write_text(text, encoding="utf-8")
        done.append("system settings entry")

    shim = SHARE / "systemsettings-shim.sh"
    if shim.exists():
        SETTINGS_SHIM.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(shim, SETTINGS_SHIM)
        SETTINGS_SHIM.chmod(0o755)
        done.append("systemsettings shim")
    return done


def remove_settings_replacement() -> None:
    SETTINGS_ENTRY.unlink(missing_ok=True)
    try:
        first_line = SETTINGS_SHIM.read_text(encoding="utf-8", errors="replace")[:200]
    except OSError:
        first_line = ""
    if "MasonOS replaces KDE System Settings" in first_line:
        SETTINGS_SHIM.unlink(missing_ok=True)


def software_binary() -> Path:
    return HOME / ".local" / "bin" / "mason-software"


def apply_software_replacement() -> list[str]:
    """Put Mason's Software in Discover's place.

    The app gets its own launcher entry, Discover's entry is hidden with a
    NoDisplay shadow, and a ``plasma-discover`` shim ahead of /usr/bin catches
    everything else that opens Discover programmatically. ``off`` removes all
    three, so Discover comes back untouched.
    """
    done: list[str] = []
    if not software_binary().exists():
        return done

    entry = SHARE / "masons-software.desktop.in"
    if entry.exists():
        text = entry.read_text(encoding="utf-8").replace(
            "@MASONOSCTL@", str(HOME / ".local" / "bin" / "masonosctl")
        )
        SOFTWARE_ENTRY.parent.mkdir(parents=True, exist_ok=True)
        SOFTWARE_ENTRY.write_text(text, encoding="utf-8")
        SOFTWARE_ENTRY.chmod(0o755)
        done.append("software entry")

    stock = Path("/usr/share/applications/org.kde.discover.desktop")
    shadow = SHARE / "discover-shadow.desktop.in"
    if stock.exists() and shadow.exists():
        DISCOVER_SHADOW.parent.mkdir(parents=True, exist_ok=True)
        DISCOVER_SHADOW.write_text(shadow.read_text(encoding="utf-8"), encoding="utf-8")
        done.append("discover hidden")

    shim = SHARE / "plasma-discover-shim.sh"
    if shim.exists():
        DISCOVER_SHIM.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(shim, DISCOVER_SHIM)
        DISCOVER_SHIM.chmod(0o755)
        done.append("plasma-discover shim")
    return done


def remove_software_replacement() -> None:
    SOFTWARE_ENTRY.unlink(missing_ok=True)
    try:
        shadow_text = DISCOVER_SHADOW.read_text(encoding="utf-8", errors="replace")[:400]
    except OSError:
        shadow_text = ""
    if "Mason's Software replaces Discover" in shadow_text:
        DISCOVER_SHADOW.unlink(missing_ok=True)
    try:
        shim_text = DISCOVER_SHIM.read_text(encoding="utf-8", errors="replace")[:200]
    except OSError:
        shim_text = ""
    if "MasonOS replaces KDE Discover" in shim_text:
        DISCOVER_SHIM.unlink(missing_ok=True)


FILES_ENTRY = DATA_DIR / "applications" / "masons-files.desktop"
FILES_BINARY = HOME / ".local" / "bin" / "masons-files"
DOLPHIN_SHADOW = DATA_DIR / "applications" / "org.kde.dolphin.desktop"
DOLPHIN_SHIM = HOME / ".local" / "bin" / "dolphin"
TERMINAL_ENTRY = DATA_DIR / "applications" / "masons-terminal.desktop"
TERMINAL_BINARY = HOME / ".local" / "bin" / "masons-terminal"
FOLDER_MIMES = ("inode/directory", "x-scheme-handler/file")


def entry_text(template: Path) -> str | None:
    """A share/*.desktop.in with the masonosctl path substituted in."""
    if not template.exists():
        return None
    return template.read_text(encoding="utf-8").replace(
        "@MASONOSCTL@", str(HOME / ".local" / "bin" / "masonosctl"))


def write_entry(path: Path, template: Path) -> bool:
    text = entry_text(template)
    if text is None:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    path.chmod(0o755)
    return True


def mime_default(mimetype: str) -> str:
    if not have("xdg-mime"):
        return ""
    return (run(["xdg-mime", "query", "default", mimetype]).stdout or "").strip()


def apply_terminal_entry() -> bool:
    if not TERMINAL_BINARY.exists():
        return False
    return write_entry(TERMINAL_ENTRY, SHARE / "masons-terminal.desktop.in")


def remove_terminal_entry() -> None:
    TERMINAL_ENTRY.unlink(missing_ok=True)


def apply_files_replacement(manifest: dict) -> list[str]:
    """Put Mason's Files in Dolphin's place. ``off`` hands Dolphin back.

    Three pieces, all reversible: a Dolphin entry that keeps the name and the
    pins but opens Mason's Files, a ``dolphin`` command shim ahead of /usr/bin,
    and the folder MIME defaults (inode/directory, file:// links) which are
    remembered so ``off`` can restore whatever they were before.
    """
    done: list[str] = []
    if not FILES_BINARY.exists():
        return done

    if write_entry(FILES_ENTRY, SHARE / "masons-files.desktop.in"):
        done.append("files entry")

    shadow = entry_text(SHARE / "dolphin-shadow.desktop.in")
    if shadow is not None:
        DOLPHIN_SHADOW.parent.mkdir(parents=True, exist_ok=True)
        DOLPHIN_SHADOW.write_text(shadow, encoding="utf-8")
        done.append("dolphin entry")

    shim = SHARE / "dolphin-shim.sh"
    if shim.exists():
        DOLPHIN_SHIM.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(shim, DOLPHIN_SHIM)
        DOLPHIN_SHIM.chmod(0o755)
        done.append("dolphin shim")

    if have("xdg-mime"):
        saved = manifest.setdefault("mime", {})
        for mimetype in FOLDER_MIMES:
            saved.setdefault(mimetype, mime_default(mimetype))
            run(["xdg-mime", "default", "masons-files.desktop", mimetype])
        done.append("folder defaults")
    return done


def remove_files_replacement(manifest: dict) -> None:
    DOLPHIN_SHADOW.unlink(missing_ok=True)
    try:
        shim_text = DOLPHIN_SHIM.read_text(encoding="utf-8", errors="replace")[:200]
    except OSError:
        shim_text = ""
    if "MasonOS replaces KDE Dolphin" in shim_text:
        DOLPHIN_SHIM.unlink(missing_ok=True)
    saved = manifest.pop("mime", {}) or {}
    if have("xdg-mime"):
        for mimetype, desktop in saved.items():
            if desktop:
                run(["xdg-mime", "default", desktop, mimetype])


LAUNCHER_BINARY = HOME / ".local" / "bin" / "masons-launcher"
LAUNCHER_SERVICE = (Path(os.environ.get("XDG_DATA_HOME", HOME / ".local" / "share"))
                    / "dbus-1" / "services" / "org.masonos.Launcher.service")
PLASMA_LAUNCHER_ACTION = ("[\"plasmashell\", \"activate application launcher\", "
                          "\"plasmashell\", \"Activate Application Launcher\"]")


def _kglobalaccel(method: str, *arguments: str) -> tuple[int, str]:
    """Talk to kglobalaccel (the service KWin exports) through gdbus."""
    if not have("gdbus"):
        return 1, ""
    result = run(["gdbus", "call", "--session", "--dest", "org.kde.kglobalaccel",
                  "--object-path", "/kglobalaccel",
                  "--method", f"org.kde.KGlobalAccel.{method}", *arguments])
    return result.returncode, result.stdout or ""


def reload_kwin_script() -> bool:
    """Load the installed MasonOS KWin script into the running session.

    ``kpackagetool6 --upgrade`` replaces the files but KWin keeps executing the
    copy it loaded at login, so the Super-key binding added since then would not
    exist yet. Loading the file through org.kde.KWin.Scripting starts the current
    code straight away; the launcher's toggle ignores a duplicate burst, so a
    second copy of the same binding is harmless.
    """
    script = DATA_DIR / "kwin" / "scripts" / "masonos-shell" / "contents" / "code" / "main.js"
    if not (script.exists() and have("gdbus")):
        return False
    loaded = run(["gdbus", "call", "--session", "--dest", "org.kde.KWin",
                  "--object-path", "/Scripting", "--method",
                  "org.kde.kwin.Scripting.loadScript", str(script)])
    match = re.search(r"\((\d+),?\)", loaded.stdout or "")
    if loaded.returncode != 0 or not match:
        return False
    started = run(["gdbus", "call", "--session", "--dest", "org.kde.KWin",
                   "--object-path", f"/Scripting/Script{match.group(1)}",
                   "--method", "org.kde.kwin.Script.run"])
    return started.returncode == 0


def apply_launcher_service() -> bool:
    """Install the D-Bus service file the Super key uses to wake the launcher."""
    template = SHARE / "org.masonos.Launcher.service.in"
    if not (LAUNCHER_BINARY.exists() and template.exists()):
        return False
    LAUNCHER_SERVICE.parent.mkdir(parents=True, exist_ok=True)
    LAUNCHER_SERVICE.write_text(
        template.read_text(encoding="utf-8").replace("@LAUNCHER@", str(LAUNCHER_BINARY)),
        encoding="utf-8",
    )
    return True


def plasma_launcher_shortcut() -> str:
    """What Plasma's launcher key is right now, straight from the config."""
    if not have("kreadconfig6"):
        return ""
    result = run(["kreadconfig6", "--file", "kglobalshortcutsrc", "--group", "plasmashell",
                  "--key", "activate application launcher"])
    return (result.stdout or "").strip()


def take_launcher_shortcut() -> bool:
    """Hand the bare Meta key to Mason's Launcher instead of Plasma's launcher.

    Plasma's launcher action holds Meta in kglobalaccel; leaving it bound would
    open both launchers on one key press. ``revert`` writes the old value back.
    """
    if not LAUNCHER_BINARY.exists():
        return False
    code, _ = _kglobalaccel("setForeignShortcutKeys", PLASMA_LAUNCHER_ACTION, "@a(ai) []")
    return code == 0


def restore_launcher_shortcut(saved: str = "") -> bool:
    """Give Meta back to Plasma's own launcher.

    kglobalaccel cannot always hand a foreign action its defaults back, so the
    value saved during the transform is written to the config as well; the
    plasmashell restart that comes with ``off`` picks it up.
    """
    restored = False
    code, out = _kglobalaccel("defaultShortcut", PLASMA_LAUNCHER_ACTION)
    match = re.search(r"\[([0-9,\s]*)\]", out)
    if code == 0 and match and match.group(1).strip():
        code, _ = _kglobalaccel("setForeignShortcut", PLASMA_LAUNCHER_ACTION,
                                "[" + match.group(1) + "]")
        restored = code == 0
    if saved and have("kwriteconfig6"):
        run(["kwriteconfig6", "--file", "kglobalshortcutsrc", "--group", "plasmashell",
             "--key", "activate application launcher", saved])
        restored = True
    return restored


def ensure_installed() -> bool:
    return (DATA_DIR / "plasma" / "plasmoids" / APP_ID / "metadata.json").exists()


# ── commands ─────────────────────────────────────────────────────────────────


def transform(dry_run: bool = False, quiet: bool = False) -> int:
    if not have("plasmashell"):
        print("masonosctl: no KDE Plasma session found.", file=sys.stderr)
        return 1
    version = plasma_version()
    if version and version[0] < 6:
        print(
            f"masonosctl: MasonOS needs KDE Plasma 6 — this session runs Plasma {plasma_version_text()}.",
            file=sys.stderr,
        )
        return 1
    if not have("kpackagetool6"):
        print(
            "masonosctl: kpackagetool6 is missing (KDE Frameworks 6) — install it and retry.",
            file=sys.stderr,
        )
        return 1
    if dry_run:
        print("masonosctl dry run — would apply:")
        print(f"  palette        {SCHEME}")
        print(f"  plasma style   {DESKTOP_THEME}")
        print(f"  look and feel  {LOOK_AND_FEEL}")
        print(f"  decoration     {DECORATION}")
        print(f"  icons          {ICON_THEME}")
        print(f"  kwin script    {KWIN_SCRIPT}")
        print(f"  panels         top bar + dock, bot widget {APP_ID}")
        print(f"  wallpaper      {WALLPAPER}")
        info = kscreen_info() or {}
        if info:
            notch = notch_info(float(info.get("scale") or 1.0))
            print(f"  display        {info['name']} {info['width']}x{info['height']} "
                  f"@{format_scale(info['scale'])} -> {format_scale(recommended_scale(info['ppi']))} "
                  f"({info['ppi']:.0f} ppi)")
            print(f"  notch          {'yes — edge layout, bar clears it' if notch and notch['visible'] else 'none'}")
        return 0
    if not ensure_installed():
        print("masonosctl: MasonOS is not installed yet — run masonos/install.sh first.", file=sys.stderr)
        return 1

    manifest = read_manifest()
    if not manifest.get("active"):
        # Keep anything install.sh already remembered (it migrates a pre-MasonDE
        # install and seeds the original values); snapshot() only fills gaps.
        manifest.setdefault("settings", {})
        manifest.setdefault("gtk", {})
        manifest["active"] = False
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if APPLETSRC.exists() and not APPLETSRC_BACKUP.exists():
            shutil.copy2(APPLETSRC, APPLETSRC_BACKUP)
        if APPLETSRC_BACKUP.exists():
            manifest["appletsrc"] = str(APPLETSRC_BACKUP)
        snapshot(manifest)
        write_manifest(manifest)

    if not shell_ready():
        print("masonosctl: plasmashell never answered — is the Plasma session up?", file=sys.stderr)
        return 1

    install_assets()
    apply_settings_replacement()
    apply_launcher_service()
    take_launcher_shortcut()
    reload_kwin_script()
    apply_software_replacement()
    apply_terminal_entry()
    apply_files_replacement(manifest)
    apply_look_and_feel()          # may re-layout panels; we rebuild them below
    apply_scheme_and_wallpaper()
    apply_fonts()
    apply_desktop_theme()
    apply_icons()
    apply_cursor()
    apply_decoration()
    apply_kwin_script()
    apply_gtk()

    # This panel is 224 ppi and the notch eats the top 64px, so the scale and the
    # bar geometry have to be settled before the panel is built.
    prefs = load_prefs()
    display = prepare_display(manifest, quiet=quiet)
    write_manifest(manifest)

    bot_up = start_bot()

    try:
        panels = build_panels(display["barHeight"], display["notched"], prefs["dockHeight"])
    except RuntimeError as err:
        print(f"masonosctl: {err}", file=sys.stderr)
        return 1

    if LAUNCHER_BINARY.exists() and not manifest.get("launcherShortcut"):
        manifest["launcherShortcut"] = plasma_launcher_shortcut()
    manifest.update({"active": True, "panels": panels, "updated": int(time.time())})
    write_manifest(manifest)

    if not quiet:
        note = "" if bot_up else " Mason Bot bridge did not start; see ~/.cache/masonos/bot.log."
        notify("MasonOS", f"Transformed: bar, dock, palette, decoration, splash.{note}")
        print(f"masonosctl: MasonOS applied (panels {panels}).")
    return 0


def revert(quiet: bool = False) -> int:
    manifest = read_manifest()
    was_active = bool(manifest.get("active"))

    stop_bot()

    # Hand Meta back before plasmashell restarts, so it reads the file we write.
    saved_meta = str(manifest.get("launcherShortcut") or "")
    restore_launcher_shortcut(saved_meta)

    backup = manifest.get("appletsrc")
    backup_path = Path(backup) if backup else None
    usable = bool(backup_path and backup_path.exists() and not appletsrc_has_masonos(backup_path))
    if usable:
        shutil.copy2(backup_path, APPLETSRC)
        if not restart_plasmashell():
            print("masonosctl: plasmashell restart failed; log out to finish restoring panels.", file=sys.stderr)
    elif was_active or appletsrc_has_masonos(APPLETSRC):
        # No trustworthy snapshot (or it captured a MasonOS layout): rebuild Plasma's
        # stock panels, then adopt that as the baseline for future transforms.
        if restore_stock_panels():
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            time.sleep(1.5)
            shutil.copy2(APPLETSRC, APPLETSRC_BACKUP)
            manifest["appletsrc"] = str(APPLETSRC_BACKUP)

    restore_settings(manifest)
    saved_display = manifest.get("display") or {}
    if saved_display.get("output") and saved_display.get("scale") and have("kscreen-doctor"):
        run(["kscreen-doctor",
             f"output.{saved_display['output']}.scale.{format_scale(float(saved_display['scale']))}"])
        manifest["display"] = {}
    remove_gtk_include()
    remove_settings_replacement()
    remove_software_replacement()
    remove_terminal_entry()
    remove_files_replacement(manifest)
    restore_launcher_shortcut(str(manifest.pop("launcherShortcut", "") or ""))
    reconfigure_kwin()

    manifest["active"] = False
    manifest["settings"] = {}
    manifest["gtk"] = {}
    write_manifest(manifest)

    if not quiet:
        notify("MasonOS", "Reverted to your Plasma setup." if was_active else "Nothing was applied.")
        print("masonosctl: reverted.")
    return 0


# ── updates ──────────────────────────────────────────────────────────────────


def parse_version(text: str) -> str:
    """The MASONOS_VERSION="x.y.z" line of an install.sh, or ""."""
    match = re.search(r'^MASONOS_VERSION="([^"]+)"', text, re.MULTILINE)
    return match.group(1).strip() if match else ""


def installed_version() -> str:
    try:
        version = VERSION_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        version = ""
    if version:
        return version
    # Older installs wrote no state file: read the checkout this script lives in.
    try:
        return parse_version((ROOT / "install.sh").read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return ""


def version_key(version: str) -> tuple[int, ...]:
    """1.2.10 sorts after 1.2.9; anything odd sorts below everything."""
    parts = [int(part) for part in re.findall(r"\d+", version)[:4]]
    if not parts:
        return (0,)
    return tuple(parts + [0] * (3 - len(parts)))


def fetch_installer() -> str:
    """The published install.sh at UPDATE_URL, as text."""
    request = urllib.request.Request(
        UPDATE_URL,
        headers={"User-Agent": f"MasonOS/{installed_version() or '0'} update-check"},
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.read().decode("utf-8", "replace")


def remote_version(refresh: bool = False) -> tuple[str, str]:
    """(published version, error). Cached for six hours so the panel can poll."""
    now = int(time.time())
    try:
        cached = json.loads(UPDATE_CHECK_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        cached = {}
    if not isinstance(cached, dict):
        cached = {}
    cached_version = str(cached.get("version") or "")
    if not refresh and cached_version and now - int(cached.get("checked") or 0) < UPDATE_CHECK_TTL:
        return cached_version, ""

    try:
        version = parse_version(fetch_installer())
    except Exception as err:  # offline, DNS, TLS, server error — none are fatal
        # A stale answer beats an error: the release did not get older.
        if cached_version:
            return cached_version, ""
        return "", f"could not read {UPDATE_URL}: {err}"
    if not version:
        return "", "the published installer has no MASONOS_VERSION line"

    try:
        UPDATE_CHECK_FILE.parent.mkdir(parents=True, exist_ok=True)
        UPDATE_CHECK_FILE.write_text(json.dumps({"version": version, "checked": now}) + "\n")
    except OSError:
        pass
    return version, ""


def check_update(as_json: bool = False, refresh: bool = False) -> int:
    current = installed_version()
    latest, error = remote_version(refresh)
    outdated = bool(latest and current) and version_key(latest) > version_key(current)

    if as_json:
        print(json.dumps({
            "current": current,
            "latest": latest,
            "outdated": outdated,
            "url": UPDATE_URL,
            "error": error,
        }))
        return 0

    if not latest:
        print(f"masonosctl: {error or 'could not check for updates'}.", file=sys.stderr)
        return 1
    if outdated:
        print(f"MasonOS {latest} is published; this install is {current or 'unknown'}.")
        print("masonosctl: run `masonosctl update` to install it.")
    else:
        print(f"MasonOS is up to date ({current or 'unknown'}, latest {latest}).")
    return 0


def perform_update() -> int:
    """Download the published installer and run it — the same path as a fresh install."""
    try:
        text = fetch_installer()
    except Exception as err:
        print(f"masonosctl: could not download the update from {UPDATE_URL}: {err}", file=sys.stderr)
        return 1
    if "MASONOS_VERSION" not in text or "MasonOS" not in text:
        print("masonosctl: the downloaded file does not look like the MasonOS installer; "
              "not running it.", file=sys.stderr)
        return 1

    latest = parse_version(text)
    target = CACHE_DIR / "update" / "install.sh"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(text, encoding="utf-8")
    target.chmod(0o755)

    current = installed_version()
    notify("MasonOS", f"Updating to {latest or 'the latest release'}…")
    print(f"masonosctl: installing MasonOS {latest or 'latest'}"
          + (f" (was {current})" if current else "") + f" from {target}")
    code = subprocess.call(["bash", str(target)])
    if code == 0:
        notify("MasonOS", "Updated — the shell is now on the new release.")
        print("masonosctl: updated.")
        return 0
    notify("MasonOS", "The update did not finish — see the terminal or ~/.cache/masonos/update.log.")
    print(f"masonosctl: the update installer exited with {code}.", file=sys.stderr)
    return code


def status() -> int:
    manifest = read_manifest()
    health = bot_health()
    print(f"version         : {installed_version() or 'unknown'}")
    print(f"active          : {'yes' if manifest.get('active') else 'no'}")
    print(f"installed       : {'yes' if ensure_installed() else 'no'}")
    print(f"session         : {session_type() or 'unknown'} · Plasma {plasma_version_text()}")
    print(f"colour scheme   : {kread('kdeglobals', 'General', 'ColorScheme') or '—'}")
    print(f"plasma style    : {kread('plasmarc', 'Theme', 'name') or '—'}")
    print(f"look and feel   : {kread('kdeglobals', 'KDE', 'LookAndFeelPackage') or '—'}")
    print(f"decoration      : {kread('kwinrc', 'org.kde.kdecoration2', 'theme') or '—'}")
    print(f"icons           : {kread('kdeglobals', 'Icons', 'Theme') or '—'}")
    print(f"kwin script     : {kread('kwinrc', 'Plugins', f'{KWIN_SCRIPT}Enabled') or '—'}")
    print(f"panels          : {manifest.get('panels') or '—'}")
    info = kscreen_info() or {}
    if info:
        notch = notch_info(float(info.get("scale") or 1.0))
        shape = "notched, edge layout" if notch and notch["visible"] else "centred clock"
        print(f"display         : {info['name']} {info['width']}x{info['height']} "
              f"@{format_scale(info['scale'])} ({info['ppi']:.0f} ppi, {shape})")
        if notch:
            print(f"notch           : {notch['heightPx']}px physical, "
                  f"{notch['heightLogical']:.0f}px logical, "
                  f"{'visible' if notch['visible'] else 'hidden by the kernel'}")
    print(f"bot bridge      : {'running' if health else 'stopped'}"
          + (f" (configured: {'yes' if health.get('configured') else 'no'})" if health else ""))
    saved = manifest.get("settings") or {}
    if saved:
        previous = saved.get("kdeglobals", {}).get("General", {}).get("ColorScheme")
        print(f"would restore   : scheme {previous or '—'}, "
              f"decoration {saved.get('kwinrc', {}).get('org.kde.kdecoration2', {}).get('theme') or '—'}")
    print(f"manifest        : {MANIFEST_FILE}")
    return 0


def apply_lockscreen() -> int:
    """Brand the lock screen: MasonOS artwork instead of the desktop wallpaper."""
    source = SHARE / "wallpapers" / "masonos-lock.png"
    target = DATA_DIR / "wallpapers" / "masonos-lock.png"
    if source.exists():
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)
    image = target if target.exists() else source
    if not image.exists():
        print("masonosctl: no lock screen artwork installed.", file=sys.stderr)
        return 1
    if not have("kwriteconfig6"):
        print("masonosctl: kwriteconfig6 is missing; cannot set the lock screen.", file=sys.stderr)
        return 1
    run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Greeter",
         "--key", "WallpaperPlugin", "org.kde.image"])
    for key, value in (("Image", str(image)), ("PreviewImage", str(image))):
        run(["kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Greeter",
             "--group", "Wallpaper", "--group", "org.kde.image", "--group", "General",
             "--key", key, value])
    print(f"masonosctl: lock screen artwork set to {image}")
    return 0


def bot_command(action: str) -> int:
    if action in ("restart", "start"):
        stop_bot()
        if start_bot():
            print("masonosctl: bot bridge running")
            return 0
        print("masonosctl: bot bridge did not start; see ~/.cache/masonos/bot.log", file=sys.stderr)
        return 1
    if action == "stop":
        stop_bot()
        print("masonosctl: bot bridge stopped")
        return 0
    health = bot_health()
    if health:
        print(f"bot bridge      : running (configured: {'yes' if health.get('configured') else 'no'})")
    else:
        print("bot bridge      : stopped")
    return 0


def display_report(fix: bool) -> int:
    info = kscreen_info()
    if not info:
        if not have("kscreen-doctor"):
            print(
                "masonosctl: kscreen-doctor is not installed (the `kscreen` package), "
                "so the display cannot be inspected.",
                file=sys.stderr,
            )
        else:
            print("masonosctl: kscreen-doctor could not report an output.", file=sys.stderr)
        return 1
    scale = float(info["scale"] or 1.0)
    notch = notch_info(scale)
    target = recommended_scale(info["ppi"])
    notched = bool(notch and notch["visible"])
    bar = DEFAULT_BAR_HEIGHT
    if notched:
        bar = max(bar, int(math.ceil(notch["heightLogical"])) + 8)

    print(f"output      : {info['name']} {info['width']}x{info['height']} "
          f"(logical {info['logicalWidth']:.0f}px wide)")
    print(f"scale       : {format_scale(scale)}  recommended {format_scale(target)} "
          f"({info['ppi']:.0f} ppi -> {info['ppi'] / target:.0f} ppi effective)")
    if notch:
        print(f"notch       : {notch['heightPx']}px physical, {notch['heightLogical']:.0f}px logical, "
              f"{'visible' if notch['visible'] else 'hidden by the kernel'}")
    else:
        print("notch       : none detected")
    print(f"top bar     : {bar}px, "
          + ("edge clusters with the centre clear" if notched else "centred clock"))

    if not fix:
        if scale < target - 0.05:
            print("masonosctl: run `masonosctl display --fix` to apply this.")
        return 0

    manifest = read_manifest()
    state = prepare_display(manifest)
    write_manifest(manifest)
    try:
        panels = build_panels(state["barHeight"], state["notched"])
    except RuntimeError as err:
        print(f"masonosctl: {err}", file=sys.stderr)
        return 1
    manifest.update({"panels": panels, "updated": int(time.time())})
    write_manifest(manifest)
    after = kscreen_info() or info
    notify("MasonOS", f"Display at {format_scale(after['scale'])}, bar {state['barHeight']}px.")
    if scale >= target - 0.05:
        print(f"masonosctl: scale {format_scale(scale)} is already at or above the "
              f"recommendation; layout rebuilt, panels {panels}.")
    else:
        print(f"masonosctl: display at {format_scale(after['scale'])}, panels {panels}.")
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="masonosctl", description="Transform Plasma into MasonOS.")
    parser.add_argument("command", nargs="?", default="toggle",
                        choices=["on", "off", "reload", "toggle", "status", "display",
                                 "lockscreen", "bot", "settings", "software", "files",
                                 "terminal", "launcher", "transform", "revert",
                                 "check-update", "update"])
    parser.add_argument("action", nargs="?", default="status",
                        help="with bot: status | start | stop | restart")
    parser.add_argument("--quiet", action="store_true", help="no notifications")
    parser.add_argument("--dry-run", action="store_true", help="show what transform would do")
    parser.add_argument("--fix", action="store_true", help="with display: apply the recommended scaling")
    parser.add_argument("--json", action="store_true", help="with check-update: one JSON line")
    parser.add_argument("--refresh", action="store_true", help="with check-update: ignore the cache")
    args = parser.parse_args(argv)

    command = {"transform": "on", "revert": "off"}.get(args.command, args.command)

    if command == "status":
        return status()
    if command == "check-update":
        return check_update(args.json, args.refresh)
    if command == "update":
        return perform_update()
    if command == "display":
        return display_report(args.fix)
    if command == "lockscreen":
        return apply_lockscreen()
    if command == "bot":
        return bot_command(args.action)
    if command == "settings":
        fallback = Path.home() / ".local" / "bin" / "masonos-settings"
        binary = shutil.which("masonos-settings") or str(fallback)
        if not Path(binary).exists():
            print("masonosctl: masonos-settings is not installed — run masonos/install.sh.",
                  file=sys.stderr)
            return 1
        if not have_pyside():
            print(
                "masonosctl: MasonOS Settings needs PySide6 — run masonos/install.sh, "
                "which installs it into ~/.local/share/masonos/venv.",
                file=sys.stderr,
            )
            return 1
        os.execvp(binary, [binary])
    if command == "software":
        binary = software_binary()
        if not binary.exists():
            found = shutil.which("mason-software")
            if not found:
                print("masonosctl: Mason's Software is not installed — run masonos/install.sh.",
                      file=sys.stderr)
                return 1
            binary = Path(found)
        if not have_pyside():
            print(
                "masonosctl: Mason's Software needs PySide6 — run masonos/install.sh, "
                "which installs it into ~/.local/share/masonos/venv.",
                file=sys.stderr,
            )
            return 1
        page = args.action if args.action in ("discover", "updates", "installed", "flatpak") else None
        argv = [str(binary)] + (["--page", page] if page else [])
        os.execvp(str(binary), argv)
    if command == "launcher":
        binary = HOME / ".local" / "bin" / "masons-launcher"
        if not binary.exists():
            found = shutil.which("masons-launcher")
            if not found:
                print("masonosctl: Mason's Launcher is not installed — run masonos/install.sh.",
                      file=sys.stderr)
                return 1
            binary = Path(found)
        if not have_pyside():
            print(
                "masonosctl: Mason's Launcher needs PySide6 — run masonos/install.sh, "
                "which installs it into ~/.local/share/masonos/venv.",
                file=sys.stderr,
            )
            return 1
        if have("gdbus"):
            # A resident launcher already owns the name: ask it instead of
            # starting a second copy of the window.
            shown = run(["gdbus", "call", "--session", "--dest", "org.masonos.Launcher",
                         "--object-path", "/Launcher", "--method",
                         "local.LauncherService.show"])
            if shown.returncode == 0:
                return 0
        os.execvp(str(binary), [str(binary)])
    if command == "terminal":
        binary = TERMINAL_BINARY
        if not binary.exists():
            found = shutil.which("masons-terminal")
            if not found:
                print("masonosctl: Mason's Terminal is not installed — run masonos/install.sh.",
                      file=sys.stderr)
                return 1
            binary = Path(found)
        if not have_pyside():
            print(
                "masonosctl: Mason's Terminal needs PySide6 — run masonos/install.sh, "
                "which installs it into ~/.local/share/masonos/venv.",
                file=sys.stderr,
            )
            return 1
        argv = [str(binary)]
        if args.action and args.action != "status":
            argv.append(args.action)
        os.execvp(str(binary), argv)
    if command == "files":
        binary = FILES_BINARY
        if not binary.exists():
            found = shutil.which("masons-files")
            if not found:
                print("masonosctl: Mason's Files is not installed — run masonos/install.sh.",
                      file=sys.stderr)
                return 1
            binary = Path(found)
        if not have_pyside():
            print(
                "masonosctl: Mason's Files needs PySide6 — run masonos/install.sh, "
                "which installs it into ~/.local/share/masonos/venv.",
                file=sys.stderr,
            )
            return 1
        argv = [str(binary)]
        target = args.action
        if target and target != "status":          # from the desktop entry's %U
            if target.startswith("file://"):
                target = unquote(urlparse(target).path)
            argv.append(target)
        os.execvp(str(binary), argv)
    if command == "on":
        return transform(args.dry_run, args.quiet)
    if command == "off":
        return revert(args.quiet)
    if command == "toggle":
        return revert(args.quiet) if read_manifest().get("active") else transform(False, args.quiet)

    code = revert(args.quiet)
    if code != 0:
        return code
    time.sleep(1.5)
    return transform(False, args.quiet)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
