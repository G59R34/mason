#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Mason's Files
GenericName=File Manager
Comment=Browse, copy, move and organise your files
Exec=@MASONOSCTL@ files %U
Icon=system-file-manager
Terminal=false
Categories=Qt;KDE;System;FileManager;
Keywords=files;folder;explorer;manager;browse;copy;move;masonos;
MimeType=inode/directory;x-scheme-handler/file;
X-KDE-StartupNotify=true
StartupWMClass=masons-files
NoDisplay=false
